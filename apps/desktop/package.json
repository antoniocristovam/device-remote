{
  "name": "@rc/desktop",
  "productName": "Remote Controller",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop controller for Remote Controller (Android remote control with chat)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "icon": "electron scripts/render-icon.cjs",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@rc/crypto-proto": "0.1.0",
    "@rc/protocol": "0.1.0",
    "@rc/signaling": "0.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "author": {
    "name": "Remote Controller"
  }
}
