<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements. Only what Electron needs to run (V8 JIT); the app is not
  sandboxed (Developer ID distribution, not the Mac App Store). Deliberately absent: camera,
  microphone, screen recording, Apple Events, disabled library validation. The desktop only shows
  the phone's screen, it never captures this Mac.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
